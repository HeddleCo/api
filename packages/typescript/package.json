{
  "name": "@heddleco/api",
  "version": "0.31.0-alpha.3",
  "description": "Generated TypeScript types for the Heddle public API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeddleCo/api.git"
  },
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "compile-treadle.mjs"
  ],
  "bin": {
    "treadle-compile": "./compile-treadle.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./shared": "./dist/shared.js",
    "./signing": "./dist/signing.js",
    "./framing": "./dist/framing.js",
    "./treadle": "./dist/treadle.js",
    "./treadle-authoring": "./dist/treadle-authoring.js",
    "./treadle-compile": "./compile-treadle.mjs",
    "./common": "./dist/common/index.js",
    "./repository": "./dist/repository_pb.js",
    "./attachment-authorization": "./dist/attachment-authorization.js",
    "./v2": "./dist/v1alpha2/index.js",
    "./v2/observation": "./dist/v1alpha2/observation.js",
    "./v2/client": "./dist/v1alpha2/client.js",
    "./v2/owner-certificates": "./dist/v1alpha2/owner-certificates.js",
    "./v2/password-owner": "./dist/v1alpha2/password-owner.js",
    "./v2/mint-root-association": "./dist/v1alpha2/mint-root-association.js",
    "./v2/spool-creation": "./dist/v1alpha2/spool-creation.js",
    "./v2/owner-actions": "./dist/v1alpha2/owner-actions.js",
    "./v2/provider": "./dist/v1alpha2/provider.js",
    "./v2/collaboration": "./dist/v1alpha2/collaboration.js",
    "./v2/source-targets": "./dist/v1alpha2/source-targets.js",
    "./v2/pairing": "./dist/v1alpha2/pairing.js",
    "./v2/thread-control": "./dist/v1alpha2/thread-control.js",
    "./v2/thread-genesis": "./dist/v1alpha2/thread-genesis.js",
    "./v2/evidence": "./dist/v1alpha2/evidence.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@noble/hashes": "2.3.0"
  }
}
